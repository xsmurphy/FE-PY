# ===== Runtime =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ===== Database =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facturacion

# ===== Redis (cola BullMQ + idempotency + rate limit) =====
REDIS_URL=redis://localhost:6379

# ===== Object storage (MinIO en dev, DO Spaces en prod) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=facturacion-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ===== Envelope encryption =====
# KEK master de 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP OFFLINE. Si se pierde, todos los certs quedan inaccesibles.
MASTER_KEY_BASE64=

# ===== SIFEN pipeline =====
# false = generar+validar pero NO firmar ni enviar (útil sin cert)
# true  = pipeline completo hasta SIFEN
ENABLE_SIFEN=false

# ===== Observability (opcional en dev) =====
SENTRY_DSN=
