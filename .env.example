# Configuración para firma y envío a SIFEN
# Copiar a .env y completar cuando tengas el certificado digital.

# Ruta absoluta al certificado PKCS#12 de prueba
SIFEN_CERT_PATH=/ruta/absoluta/al/Certificado.p12

# Contraseña del certificado
SIFEN_CERT_PASSWORD=

# CSC (Código de Seguridad del Contribuyente) para generación de QR
# Se obtiene en el portal ekuatia.set.gov.py → Perfil → Ambiente de prueba
SIFEN_CSC_ID=1
SIFEN_CSC=

# Ambiente SIFEN: "test" o "prod"
SIFEN_ENV=test
